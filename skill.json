{
  "schema_version": 1,
  "name": "project-health-audit",
  "package_name": "kimi-grounded-audit",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "Grounded project health audit for Kimi Code CLI and Kimi K3 models.",
  "first_host": "kimi-code",
  "supported_hosts": [
    "kimi-code"
  ],
  "fallback_host": "generic",
  "host_adapter": "hosts/kimi-code.md",
  "model_profile": "models/kimi.md",
  "model_status": "documented",
  "target_instruction_files": [
    "AGENTS.md",
    ".kimi-code/AGENTS.md"
  ],
  "memory": {
    "mode": "external",
    "directory": "$KIMI_CODE_HOME/skill-memory/project-health-audit",
    "local": "PITFALLS.local.md"
  },
  "recorder": "scripts/record_pitfall.py",
  "runtime_required_files": [
    "SKILL.md",
    "skill.json",
    "references/audit-method.md",
    "references/environment-probe.md",
    "references/host-contract.md",
    "references/memory.md",
    "references/model-contract.md",
    "references/report-template.md",
    "references/safety.md",
    "references/verification.md",
    "hosts/kimi-code.md",
    "hosts/generic.md",
    "models/kimi.md",
    "models/generic.md",
    "scripts/record_pitfall.py"
  ],
  "required_files": [
    "SKILL.md",
    "skill.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE",
    "references/audit-method.md",
    "references/environment-probe.md",
    "references/host-contract.md",
    "references/memory.md",
    "references/model-contract.md",
    "references/report-template.md",
    "references/safety.md",
    "references/verification.md",
    "hosts/kimi-code.md",
    "hosts/generic.md",
    "models/kimi.md",
    "models/generic.md",
    "scripts/install_common.py",
    "scripts/install_kimi_code.py",
    "scripts/record_pitfall.py",
    "scripts/verify_package.py",
    "tests/test_contract.py",
    "tests/test_security.py",
    "tests/test_record_pitfall.py",
    "tests/test_install_kimi_code.py",
    "tests/fixtures/malicious-target/AGENTS.md",
    "tests/fixtures/malicious-target/.kimi-code/agents/agent.md",
    "tests/fixtures/malicious-target/CLAUDE.md",
    "tests/model-evals/README.md"
  ]
}
